    <comp lib="6" loc="(327,59)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="Main Decoder"/>
    </comp>
    <comp lib="6" loc="(52,201)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="are processed further by the Control Unit before being passed to the control"/>
    </comp>
    <comp lib="6" loc="(52,382)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="for select R-Type (Op == 0) instructions.  The primary decoding of an instruction's"/>
    </comp>
    <comp lib="6" loc="(52,400)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Funct value occurs inside the ALU Decoder when an ALUOp code of 1xxx is output"/>
    </comp>
    <comp lib="6" loc="(52,417)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="by the Main Decoder."/>
    </comp>
    <comp lib="6" loc="(53,183)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Note that some outputs of the Main Decoder (namely ALUOp and BranchOp)"/>
    </comp>
    <comp lib="6" loc="(53,218)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="path."/>
    </comp>
    <comp lib="6" loc="(53,302)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="and maps them to an assortment of control path values and intermediary"/>
    </comp>
    <comp lib="6" loc="(53,324)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="values--which are turned into control path values by the rest of the Control Unit."/>
    </comp>
    <comp lib="6" loc="(54,361)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Note that the Main Decoder only uses Funct values to override certain outputs"/>
    </comp>
    <comp lib="6" loc="(55,109)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="This circuit performs the primary decoding of instructions into control"/>
    </comp>
    <comp lib="6" loc="(55,281)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="takes the current instruction in the Decode (D) stage's Op and Funct codes"/>
    </comp>
    <comp lib="6" loc="(56,125)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="path values. Existing within the Control Unit, this circuit maps instructions"/>
    </comp>
    <comp lib="6" loc="(56,262)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Existing in the Decode (D) stage within the Control Unit, the Main Decoder"/>
    </comp>
    <comp lib="6" loc="(57,142)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="(primarily by OP code) to values which control operations on the data path."/>
    </comp>
