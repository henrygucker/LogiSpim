    <comp lib="6" loc="(41,406)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="stored by this circuit, a nop instruction is output and the"/>
    </comp>
    <comp lib="6" loc="(41,423)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="InvalidAddressFlag output is set HIGH."/>
    </comp>
    <comp lib="6" loc="(42,388)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="If Address is not word-aligned or not within a region of memory"/>
    </comp>
    <comp lib="6" loc="(43,308)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="In other words, this region is 64MB starting at address 0x80000000."/>
    </comp>
    <comp lib="6" loc="(44,367)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="the 32-bit instruction (Instruction) stored at the given address."/>
    </comp>
    <comp lib="6" loc="(45,287)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="(or the &quot;.ktext&quot; region). This spans from address 0x80000000 to 0x803fffff."/>
    </comp>
    <comp lib="6" loc="(45,348)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Given a word-aligned address (Address), this circuit outputs"/>
    </comp>
    <comp lib="6" loc="(45,99)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="This circuit contains the ROM modules which store instructions for"/>
    </comp>
    <comp lib="6" loc="(46,115)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="the currently loaded program.  Rather than just storing the &quot;.text&quot;"/>
    </comp>
    <comp lib="6" loc="(46,148)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="the processor's kernel which handles syscalls."/>
    </comp>
    <comp lib="6" loc="(46,209)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="memory (or the &quot;.text&quot; region). This spans from address 0x00400000 to"/>
    </comp>
    <comp lib="6" loc="(46,268)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Additionally, this circuit stores the kernel's instruction memory"/>
    </comp>
    <comp lib="6" loc="(47,132)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="section of the currently loaded program, this circuit also stores"/>
    </comp>
    <comp lib="6" loc="(47,191)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="The first region of memory stored by this circuit is the program instruction"/>
    </comp>
    <comp lib="6" loc="(47,226)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0x043fffff. In other words, this region is 64MB starting at address 0x00400000."/>
    </comp>
