    <comp lib="7" loc="(785,140)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0x - WriteData == ALUOut"/>
    </comp>
    <comp lib="7" loc="(785,155)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="10 - WriteData == ReadData (memory)"/>
    </comp>
    <comp lib="7" loc="(785,170)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="11 - WriteData == PCPlus4 and WriteReg == $ra"/>
    </comp>
    <comp lib="7" loc="(785,215)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0000 - lb"/>
    </comp>
    <comp lib="7" loc="(785,230)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0001 - lh"/>
    </comp>
    <comp lib="7" loc="(785,245)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0010 - lw"/>
    </comp>
    <comp lib="7" loc="(785,260)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0011 - N/A"/>
    </comp>
    <comp lib="7" loc="(785,275)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0100 - lbu"/>
    </comp>
    <comp lib="7" loc="(785,290)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0101 - lhu"/>
    </comp>
    <comp lib="7" loc="(785,305)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0110 - lwl"/>
    </comp>
    <comp lib="7" loc="(785,320)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0111 - lwr"/>
    </comp>
    <comp lib="7" loc="(785,365)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="00 - No Branch/Jump"/>
    </comp>
    <comp lib="7" loc="(785,380)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="01 - beq/bne conditional branch to BTA"/>
    </comp>
    <comp lib="7" loc="(785,395)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="10 - jump to JTA (Jump Target Address)"/>
    </comp>
    <comp lib="7" loc="(785,415)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="11 - blez/bgtz conditional branch to BTA"/>
    </comp>
    <comp lib="7" loc="(785,65)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0 - No write to register"/>
    </comp>
    <comp lib="7" loc="(785,80)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="1 - Write to register in Writeback (W) stage"/>
    </comp>
