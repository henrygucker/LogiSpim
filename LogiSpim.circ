    <comp lib="6" loc="(1355,1115)" name="Text">
      <a name="text" val="&lt;-- Defaults PCSrc_D to 0b00"/>
    </comp>
    <comp lib="6" loc="(1405,1165)" name="Text">
      <a name="text" val="&lt;-- Branch if conditional branch is indicated"/>
    </comp>
    <comp lib="6" loc="(1405,1215)" name="Text">
      <a name="text" val="&lt;-- If is jump instruction, PCSrc_D == 0b10"/>
    </comp>
    <comp lib="6" loc="(1410,1260)" name="Text">
      <a name="text" val="&lt;-- If is syscall instruction, PCSrc_D == 0b11"/>
    </comp>
    <comp lib="6" loc="(1465,1180)" name="Text">
      <a name="text" val="and condition is satisfied, hence PCSrc_D == 0b01"/>
    </comp>
    <comp lib="6" loc="(1505,1000)" name="Text">
      <a name="text" val="This acts similar to the reverse of a decoder. It"/>
    </comp>
    <comp lib="6" loc="(1515,1020)" name="Text">
      <a name="text" val="&lt;-- outputs the bit address of the highest bit that is a 1."/>
    </comp>
    <comp lib="6" loc="(555,1040)" name="Text">
      <a name="text" val="OP [0]"/>
    </comp>
    <comp lib="6" loc="(720,745)" name="Text">
      <a name="text" val="If OP = 20 (0x14), is exit instruction"/>
    </comp>
    <comp lib="6" loc="(745,795)" name="Text">
      <a name="text" val="If OP = 21 (0x15), is print char instruction"/>
    </comp>
    <comp lib="6" loc="(760,1370)" name="Text">
      <a name="text" val="R-Type w/Func = 0xc is syscall"/>
    </comp>
    <comp lib="6" loc="(770,1265)" name="Text">
      <a name="text" val="Jump Instruction"/>
    </comp>
    <comp lib="6" loc="(925,1050)" name="Text">
      <a name="text" val="&lt;--"/>
    </comp>
    <comp lib="6" loc="(940,1035)" name="Text">
      <a name="text" val="Used to negate branch-ability for beq/blez if is bne/bgtz"/>
    </comp>
    <comp lib="6" loc="(960,965)" name="Text">
      <a name="font" val="SansSerif bold 22"/>
      <a name="text" val="Jump/Branching Logic"/>
    </comp>
