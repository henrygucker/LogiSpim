    <comp lib="6" loc="(324,185)" name="Text">
      <a name="text" val="Given two register addresses (Address1 &amp; Address2), the Register File"/>
    </comp>
    <comp lib="6" loc="(329,267)" name="Text">
      <a name="text" val="given address (Address3) with a new value (WriteData3) on the FALLING"/>
    </comp>
    <comp lib="6" loc="(342,202)" name="Text">
      <a name="text" val="outputs their respective registers' values (RegisterData1 &amp; RegisterData2)."/>
    </comp>
    <comp lib="6" loc="(359,247)" name="Text">
      <a name="text" val="Additionally, the Register File overwrites the contents of the register of another"/>
    </comp>
