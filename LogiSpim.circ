    <comp lib="7" loc="(2575,680)" name="Text">
      <a name="text" val="Outputs of Registers"/>
    </comp>
    <comp lib="7" loc="(290,125)" name="Text">
      <a name="text" val="the Decode (D) stage while synchronously writing values from"/>
    </comp>
    <comp lib="7" loc="(295,105)" name="Text">
      <a name="text" val="Placed within the Decode (D) stage, allows register reads inside"/>
    </comp>
    <comp lib="7" loc="(300,90)" name="Text">
      <a name="text" val="This circuit holds all general-purpose registers of the processor."/>
    </comp>
    <comp lib="7" loc="(315,35)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="Register File"/>
    </comp>
    <comp lib="7" loc="(320,185)" name="Text">
      <a name="text" val="Given two register addresses (Address1 &amp; Address2), the Register File"/>
    </comp>
    <comp lib="7" loc="(325,265)" name="Text">
      <a name="text" val="given address (Address3) with a new value (WriteData3) on the FALLING"/>
    </comp>
    <comp lib="7" loc="(340,200)" name="Text">
      <a name="text" val="outputs their respective registers' values (RegisterData1 &amp; RegisterData2)."/>
    </comp>
    <comp lib="7" loc="(355,245)" name="Text">
      <a name="text" val="Additionally, the Register File overwrites the contents of the register of another"/>
    </comp>
