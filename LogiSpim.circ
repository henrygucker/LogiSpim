    </comp>
    <comp lib="7" loc="(130,140)" name="Text">
      <a name="text" val="the Writeback (W) stage."/>
    </comp>
    <comp lib="7" loc="(145,1495)" name="Text">
      <a name="text" val="Registers addressed 0-31"/>
    </comp>
    <comp lib="7" loc="(145,1545)" name="Text">
      <a name="text" val="Write on falling clock edge,"/>
    </comp>
    <comp lib="7" loc="(180,285)" name="Text">
