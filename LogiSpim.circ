    <comp lib="7" loc="(1230,100)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="10 - ALUInputB = ZeroImm"/>
    </comp>
    <comp lib="7" loc="(1235,70)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="00 - ALUInputB = RegData2"/>
    </comp>
    <comp lib="7" loc="(1235,85)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="x1 - ALUInputB = SignImm"/>
    </comp>
    <comp lib="7" loc="(1240,150)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0 - WriteReg = rt"/>
    </comp>
    <comp lib="7" loc="(1240,165)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="1 - WriteReg = rd"/>
    </comp>
    <comp lib="7" loc="(1240,220)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0 - Continue Execution"/>
    </comp>
    <comp lib="7" loc="(1240,235)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="1 - Fix CLK HIGH until reset"/>
    </comp>
    <comp lib="7" loc="(1250,280)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0 - Do not print to emulated console"/>
    </comp>
    <comp lib="7" loc="(1250,295)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="1 - Print character stored in $a0"/>
    </comp>
    <comp lib="7" loc="(1250,355)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="00 - No Branch/Jump"/>
    </comp>
    <comp lib="7" loc="(1250,370)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="01 - beq/bne conditional branch to BTA"/>
    </comp>
    <comp lib="7" loc="(1250,385)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="10 - jump to JTA (Jump Target Address)"/>
    </comp>
    <comp lib="7" loc="(1250,400)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="11 - blez/bgtz conditional branch to BTA"/>
    </comp>
    <comp lib="7" loc="(1280,50)" name="Text">
      <a name="text" val="ALUSrcB Codes:"/>
    </comp>
    <comp lib="7" loc="(1285,265)" name="Text">
      <a name="text" val="PrintChar Codes:"/>
    </comp>
    <comp lib="7" loc="(1290,130)" name="Text">
      <a name="text" val="WriteRegSrc Codes:"/>
    </comp>
    <comp lib="7" loc="(1295,335)" name="Text">
      <a name="text" val="BranchOp Codes:"/>
    </comp>
    <comp lib="7" loc="(1320,200)" name="Text">
      <a name="text" val="SuspendProcessor Codes:"/>
    </comp>
    <comp lib="7" loc="(335,65)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="Control Unit"/>
    </comp>
    <comp lib="7" loc="(60,200)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Existing in the Decode (D) stage, the Control Unit takes an instruction's Op"/>
    </comp>
    <comp lib="7" loc="(60,220)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="and Funct codes to decode all control path values which depend purely on"/>
    </comp>
    <comp lib="7" loc="(60,240)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="those codes."/>
    </comp>
    <comp lib="7" loc="(60,270)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Determining which source the program counter should retrieve its next value"/>
    </comp>
    <comp lib="7" loc="(60,295)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="from requires branching to be handled. This requires access to the register"/>
    </comp>
    <comp lib="7" loc="(60,310)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="values read by the current instruction. So, the Control Unit outputs a BranchOp"/>
    </comp>
    <comp lib="7" loc="(60,330)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="code which feeds into the Branch Decoder to determine if any jumps or branches"/>
    </comp>
    <comp lib="7" loc="(60,350)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="occur."/>
    </comp>
    <comp lib="7" loc="(65,115)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="This circuit decodes control path values purely from an instruction's OP"/>
    </comp>
    <comp lib="7" loc="(65,135)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="and Funct codes. Some outputs of the Control Unit are processed further"/>
    </comp>
    <comp lib="7" loc="(65,150)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="by downstream decoders where more input data is required to create all control"/>
    </comp>
    <comp lib="7" loc="(65,170)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="path values necessary for the processor to execute the current instruction."/>
    </comp>
    <comp lib="7" loc="(700,885)" name="Text">
      <a name="text" val="If OP = 20 (0x14), is exit instruction"/>
    </comp>
    <comp lib="7" loc="(725,935)" name="Text">
      <a name="text" val="If OP = 21 (0x15), is print char instruction"/>
    </comp>
    <comp lib="7" loc="(760,200)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="MemOp Codes:"/>
    </comp>
    <comp lib="7" loc="(785,430)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0 - ALUInputA = RegData1"/>
    </comp>
    <comp lib="7" loc="(785,445)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="1 - ALUInputA = shamt (Zero-Extended)"/>
    </comp>
    <comp lib="7" loc="(790,155)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="10 - WriteData == ReadData (memory)"/>
    </comp>
    <comp lib="7" loc="(790,170)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="11 - WriteData == PCPlus4 and WriteReg == $ra"/>
    </comp>
    <comp lib="7" loc="(790,375)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="See ALU or ALU Decoder..."/>
    </comp>
    <comp lib="7" loc="(790,70)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0 - No write to register"/>
    </comp>
    <comp lib="7" loc="(790,85)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="1 - Write to register in Writeback (W) stage"/>
    </comp>
    <comp lib="7" loc="(795,140)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="0x - WriteData == ALUOut"/>
    </comp>
