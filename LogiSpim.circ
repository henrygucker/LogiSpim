    <comp lib="7" loc="(1335,515)" name="Text">
      <a name="text" val="&lt;-- Defaults PCSrc_D to 0b00"/>
    </comp>
    <comp lib="7" loc="(1385,565)" name="Text">
      <a name="text" val="&lt;-- Branch if conditional branch is indicated"/>
    </comp>
    <comp lib="7" loc="(1385,615)" name="Text">
      <a name="text" val="&lt;-- If is jump instruction, PCSrc_D == 0b10"/>
    </comp>
    <comp lib="7" loc="(1390,660)" name="Text">
      <a name="text" val="&lt;-- If is syscall instruction, PCSrc_D == 0b11"/>
    </comp>
    <comp lib="7" loc="(1445,580)" name="Text">
      <a name="text" val="and condition is satisfied, hence PCSrc_D == 0b01"/>
    </comp>
    <comp lib="7" loc="(1485,400)" name="Text">
      <a name="text" val="This acts similar to the reverse of a decoder. It"/>
    </comp>
    <comp lib="7" loc="(1495,420)" name="Text">
      <a name="text" val="&lt;-- outputs the bit address of the highest bit that is a 1."/>
    </comp>
    <comp lib="7" loc="(335,65)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="Branch Decoder"/>
    </comp>
    <comp lib="7" loc="(535,440)" name="Text">
      <a name="text" val="OP [0]"/>
    </comp>
    <comp lib="7" loc="(60,240)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="the BranchOp code output by the Control Unit, and the data read by this "/>
    </comp>
    <comp lib="7" loc="(60,255)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="instruction from the Register File as inputs. The Branch Decoder does so to"/>
    </comp>
    <comp lib="7" loc="(60,270)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="determine the desired value of PCSrc which controls the address of the next"/>
    </comp>
    <comp lib="7" loc="(60,285)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="instruction to be brought into the Fetch (F) stage of the pipeline."/>
    </comp>
    <comp lib="7" loc="(65,115)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="This circuit decodes an intermediary BranchOp code from the Control Unit"/>
    </comp>
    <comp lib="7" loc="(65,130)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="into the control path value which determines the address of the next"/>
    </comp>
    <comp lib="7" loc="(65,150)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="instruction to be executed. So, determining if the processor should branch"/>
    </comp>
    <comp lib="7" loc="(65,165)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="is done within this circuit."/>
    </comp>
    <comp lib="7" loc="(65,205)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Existing in the Decode (D) stage near the Control Unit, the Branch Decoder"/>
    </comp>
    <comp lib="7" loc="(65,225)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="takes the current instruction in the Decode (D) stage's opcode and funct values,"/>
    </comp>
    <comp lib="7" loc="(740,720)" name="Text">
      <a name="text" val="R-Type w/Func = 0xc is syscall"/>
    </comp>
    <comp lib="7" loc="(750,665)" name="Text">
      <a name="text" val="Jump Instruction"/>
    </comp>
    <comp lib="7" loc="(770,100)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="00 - No Branch/Jump"/>
    </comp>
    <comp lib="7" loc="(770,115)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="01 - beq/bne conditional branch to BTA"/>
    </comp>
    <comp lib="7" loc="(770,130)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="10 - jump to JTA (Jump Target Address)"/>
    </comp>
    <comp lib="7" loc="(770,150)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="11 - blez/bgtz conditional branch to BTA"/>
    </comp>
    <comp lib="7" loc="(770,210)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="00 - nextPC = PCPlus4_F"/>
    </comp>
    <comp lib="7" loc="(770,225)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="01 - nextPC = PCBranchAddr_D"/>
    </comp>
    <comp lib="7" loc="(770,240)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="10 - nextPC = PCJumpAddr_D"/>
    </comp>
    <comp lib="7" loc="(770,255)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="11 - nextPC = Syscall Start Addr"/>
    </comp>
    <comp lib="7" loc="(800,190)" name="Text">
      <a name="text" val="PCSrc Codes:"/>
    </comp>
    <comp lib="7" loc="(815,80)" name="Text">
      <a name="text" val="BranchOp Codes:"/>
    </comp>
    <comp lib="7" loc="(905,450)" name="Text">
      <a name="text" val="&lt;--"/>
    </comp>
    <comp lib="7" loc="(920,435)" name="Text">
      <a name="text" val="Used to negate branch-ability for beq/blez if is bne/bgtz"/>
    </comp>
