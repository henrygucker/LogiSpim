      <a name="color" val="#636363"/>
      <a name="halign" val="left"/>
      <a name="text" val="strings is the zero-extended numerical representation of the string's binary value"/>
    </comp>
    <comp lib="7" loc="(1050,905)" name="Text">
      <a name="color" val="#636363"/>
      <a name="halign" val="left"/>
      <a name="text" val="The constant passed into the AND gate associated with any of these binary"/>
    </comp>
    <comp lib="7" loc="(1050,940)" name="Text">
      <a name="color" val="#636363"/>
      <a name="halign" val="left"/>
      <a name="text" val="(excluding any '-' characters) with the first bit being the most significant bit."/>
    </comp>
    <comp lib="7" loc="(1050,980)" name="Text">
      <a name="color" val="#636363"/>
      <a name="halign" val="left"/>
      <a name="text" val="Updating the constant is done by typing &quot;0bxxxx...&quot; into its value field, where"/>
    </comp>
    <comp lib="7" loc="(1050,995)" name="Text">
      <a name="color" val="#636363"/>
      <a name="halign" val="left"/>
      <a name="text" val="&quot;xxx...&quot; is the binary string without any '-' characters."/>
    </comp>
