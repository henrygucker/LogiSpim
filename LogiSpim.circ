    <comp lib="7" loc="(325,55)" name="Text">
      <a name="font" val="SansSerif bold 20"/>
      <a name="text" val="Main Decoder"/>
    </comp>
    <comp lib="7" loc="(50,180)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Note that some outputs of the Main Decoder (namely ALUOp and BranchOp)"/>
    </comp>
    <comp lib="7" loc="(50,200)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="are processed further by downstream decoders before being passed to the"/>
    </comp>
    <comp lib="7" loc="(50,215)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="control path."/>
    </comp>
    <comp lib="7" loc="(50,300)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="and maps them to an assortment of control path values and intermediary"/>
    </comp>
    <comp lib="7" loc="(50,320)" name="Text">
      <a name="halign" val="left"/>
      <a name="text">values--which are turned into control path values by the rest of the Decode (D)
stage.</a>
    </comp>
    <comp lib="7" loc="(50,375)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Note that the Main Decoder only uses Funct values to override certain outputs"/>
    </comp>
    <comp lib="7" loc="(50,395)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="for select R-Type (Op == 0) instructions.  The primary decoding of an instruction's"/>
    </comp>
    <comp lib="7" loc="(50,415)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Funct value occurs inside the ALU Decoder when an ALUOp code of 1xxx is output"/>
    </comp>
    <comp lib="7" loc="(50,430)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="by the Main Decoder."/>
    </comp>
    <comp lib="7" loc="(55,105)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="This circuit performs the bulk of decoding instructions into control path"/>
    </comp>
    <comp lib="7" loc="(55,125)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="values. Existing within the Control Unit, this circuit maps instructions"/>
    </comp>
    <comp lib="7" loc="(55,140)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="(primarily by opcode) to values which control operations on the data path."/>
    </comp>
    <comp lib="7" loc="(55,260)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="Existing in the Decode (D) stage within the Control Unit, the Main Decoder"/>
    </comp>
    <comp lib="7" loc="(55,280)" name="Text">
      <a name="halign" val="left"/>
      <a name="text" val="takes the current instruction in the Decode (D) stage's opcode and funct field,"/>
    </comp>
