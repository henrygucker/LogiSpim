<!-- Redirects from henrygucker.github.io/LogiSim/ or .../LogiSim/index.html to .../LogiSpim/01_intro/index.html-->
<!-- Prevents images/assets not loading on site index.html -->
<head>
  <script>
    // Check if the user is currently at the root index.html
    if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
      // Instantly replace the history state and redirect
      window.location.replace('/01_intro/index.html');
    }
  </script>
</head>